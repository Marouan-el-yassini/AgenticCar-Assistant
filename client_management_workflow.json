    {
      "parameters": {
        "jsCode": "const today = new Intl.DateTimeFormat('en-CA', {\n    timeZone: 'Africa/Casablanca'\n}).format(new Date());\n\nconst results = [];\n\nfor (const item of items) {\n    const row = item.json;\n\n    const startDate = row[\"Start Date\"]?.trim();\n    const endDate = row[\"End Date\"]?.trim();\n\n    if (!startDate || !endDate) continue;\n\n    const daysRemaining = Math.floor(\n        (new Date(endDate) - new Date(today)) /\n        (1000 * 60 * 60 * 24)\n    );\n\n    let status = \"active\";\n\n    if (today >= endDate) {\n        status = \"expired\";\n    } else if (daysRemaining === 1) {\n        status = \"expiringSoon\";\n    }\n\n    results.push({\n        json: {\n            status,\n            rowNumber: row.rowNumber,\n            bookingId: row[\"Booking ID\"],\n            phoneNumber: row[\"WhatsApp Number\"],\n            vehicle: row[\"Vehicle\"],\n            daysRemaining\n        }\n    });\n}\n\nreturn results;"
      },
